DATABASE_PATH=/data/scanner.sqlite3
PUBLIC_APP_URL=https://scanner.example.com
CORS_ORIGINS=https://scanner.example.com
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=Lax
SESSION_TTL_HOURS=24
SCANNER_ALLOW_PRIVATE=0
REQUEST_TIMEOUT=8
MAX_CONTENT_BYTES=2000000
AUTH_MAX_ATTEMPTS=8
AUTH_WINDOW_MINUTES=15
EMAIL_FROM=SentinelScope <security@example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=1
EMAIL_VERIFY_TTL_MINUTES=60
PASSWORD_RESET_TTL_MINUTES=30
INVITE_TTL_HOURS=48
MFA_ISSUER=SentinelScope
TRUST_PROXY_HEADERS=1
